# ============================================================================
# QuantFlow — Environment Variables
# Copy to .env for local dev, or set in Render/Vercel dashboards for prod.
# ============================================================================

# ==================== Database (Supabase) ====================
# Supabase pooler URL (transaction mode, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ==================== Redis (Upstash REST API) ====================
# Free tier: 10,000 commands/day
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ==================== Auth ====================
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Stripe Payments ====================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_QUANT_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_QUANT_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# ==================== Cloudflare R2 (File Storage) ====================
# Free tier: 10 GB, 10M reads/month
R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=quantflow-uploads

# ==================== Resend (Email) ====================
# Free tier: 100 emails/day
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ==================== Sentry (Error Monitoring) ====================
# Free tier: 5,000 errors/month
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxxx

# ==================== Data Providers ====================
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# ==================== Frontend ====================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
